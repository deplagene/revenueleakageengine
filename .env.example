GO_VERSION=1.26.2

RLE_IMAGE_TAG=local
RLE_HTTP_PORT=8080
RLE_GRPC_PORT=9090
RLE_HTTP_ADDR=:8080
RLE_GRPC_ADDR=:9090
RLE_SQLITE_PATH=/data/local.db
RLE_MIGRATIONS_PATH=/app/internal/platform/sqlite/migrations
RLE_LOG_LEVEL=info
RLE_LOG_JSON=true
RLE_KAFKA_BROKERS=kafka:29092
RLE_KAFKA_GROUP_ID=revenueleakageengine
RLE_DOCUMENT_STORAGE_PATH=/data/documents
RLE_DOCUMENT_MAX_FILES_PER_UPLOAD=5
RLE_DOCUMENT_MAX_FILE_BYTES=10485760
RLE_AI_PROVIDER=nvidia
RLE_NVIDIA_API_KEY=replace-with-nvidia-key
RLE_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
RLE_NVIDIA_MODEL=nvidia/llama-3.1-nemotron-nano-8b-v1
RLE_NVIDIA_MAX_TEXT_RUNES=60000
RLE_NVIDIA_REQUEST_TIMEOUT=45s

KAFKA_IMAGE_TAG=8.2.0
KAFKA_EXTERNAL_PORT=9092
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_NODE_ID=1
KAFKA_PROCESS_ROLES=broker,controller
KAFKA_CONTROLLER_QUORUM_VOTERS=1@kafka:29093
KAFKA_LISTENERS=PLAINTEXT://kafka:29092,CONTROLLER://kafka:29093,PLAINTEXT_HOST://0.0.0.0:9092
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:29092,PLAINTEXT_HOST://localhost:9092
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT,PLAINTEXT_HOST:PLAINTEXT
KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
KAFKA_AUTO_CREATE_TOPICS_ENABLE=false
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS=0
KAFKA_LOG_RETENTION_HOURS=168
KAFKA_HEALTHCHECK_BOOTSTRAP_SERVER=localhost:9092
KAFKA_INTERNAL_BOOTSTRAP_SERVER=kafka:29092

KAFKA_UI_IMAGE_TAG=v0.7.2
KAFKA_UI_PORT=8082
KAFKA_CLUSTERS_0_NAME=local-rle
KAFKA_CLUSTERS_0_BOOTSTRAPSERVERS=kafka:29092
