package ui

templ Header(active string) {
	<header class="topbar">
		<a class="brand" href="/ui">
			<span class="brand-mark">RLE</span>
			<span class="brand-copy">
				<strong>Revenue Leakage Engine</strong>
				<small>операционный контроль выручки</small>
			</span>
		</a>
		<nav class="nav" aria-label="Основная навигация">
			<a class={ navClass(active, "dashboard") } href="/ui">Обзор</a>
			<a class={ navClass(active, "reconciliation") } href="/ui/reconciliation">Запуск сверки</a>
			<a class={ navClass(active, "cases") } href="/ui/cases">Кейсы</a>
			<a class={ navClass(active, "documents") } href="/ui/documents">Документы</a>
		</nav>
	</header>
}

templ BottomNav(active string) {
	<nav class="bottom-nav" aria-label="Мобильная навигация">
		<a class={ navClass(active, "dashboard") } href="/ui">
			<span></span>
			Обзор
		</a>
		<a class={ navClass(active, "reconciliation") } href="/ui/reconciliation">
			<span></span>
			Сверка
		</a>
		<a class={ navClass(active, "cases") } href="/ui/cases">
			<span></span>
			Кейсы
		</a>
		<a class={ navClass(active, "documents") } href="/ui/documents">
			<span></span>
			Документы
		</a>
	</nav>
}

templ DashboardPage(data DashboardPageData) {
	<!DOCTYPE html>
	<html lang="ru">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ data.Title }</title>
			<link rel="stylesheet" href="/ui/static/ui.css"/>
			<script src="/ui/static/htmx.min.js" defer></script>
		</head>
		<body>
			@Header("dashboard")
			<main class="page">
				<section class="page-header">
					<div>
						<h1>Обзор</h1>
						<p class="lede">Следите за сверками, утечками и кейсами в едином интерфейсе.</p>
					</div>
					<a class="button primary" href={ "/ui/reconciliation?tenant_id=" + data.TenantID }>Запустить сверку</a>
				</section>
				@TenantSelector(data.TenantID)
				@ifError(data.Error)
				<section class="metric-grid" aria-label="Ключевые метрики">
					<article class="metric">
						<span>Утечка за период</span>
						<strong>{ data.TotalLeakageLabel }</strong>
						<small class="trend up">+12% к предыдущему периоду</small>
					</article>
					<article class="metric">
						<span>Запусков сверки</span>
						<strong>{ data.CompletedRunsLabel }</strong>
						<small class="trend up">+7 за последний месяц</small>
					</article>
					<article class="metric">
						<span>Открытые кейсы</span>
						<strong>{ data.OpenCasesLabel }</strong>
						<small class="trend up">+2 новых</small>
					</article>
					<article class="metric">
						<span>Последний запуск</span>
						<strong>{ data.LastRunLabel }</strong>
						<small class="status-inline">Успешно</small>
					</article>
				</section>
				<section class="dashboard-grid">
					<div class="panel">
						<div class="panel-heading">
							<div>
								<p class="eyebrow">История</p>
								<h2>Последние сверки</h2>
							</div>
							<a class="text-link" href={ "/ui/reconciliation?tenant_id=" + data.TenantID }>Все запуски</a>
						</div>
						@RunsList(RunsTableData{Runs: data.Runs})
					</div>
					<div class="panel">
						<div class="panel-heading">
							<div>
								<h2>Динамика утечек</h2>
							</div>
						</div>
						@LeakageTrend()
					</div>
				</section>
			</main>
			@BottomNav("dashboard")
		</body>
	</html>
}

templ ReconciliationPage(data DashboardPageData) {
	<!DOCTYPE html>
	<html lang="ru">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ data.Title }</title>
			<link rel="stylesheet" href="/ui/static/ui.css"/>
			<script src="/ui/static/htmx.min.js" defer></script>
		</head>
		<body>
			@Header("reconciliation")
			<main class="page">
				<section class="page-header">
					<div>
						<h1>Запуск сверки</h1>
						<p class="lede">Укажите параметры, чтобы выполнить сверку выручки и выявить утечки.</p>
					</div>
				</section>
				@ifError(data.Error)
				<section class="reconciliation-layout">
					<div class="panel form-panel">
						<div class="panel-heading">
							<div>
								<p class="eyebrow">Новая сверка</p>
								<h2>Параметры запуска</h2>
							</div>
						</div>
						@RunForm(data.RunForm)
					</div>
					<div class="panel">
						<div class="panel-heading">
							<div>
								<p class="eyebrow">История</p>
								<h2>Последние запуски</h2>
							</div>
						</div>
						@RunsList(RunsTableData{Runs: data.Runs})
					</div>
				</section>
				<section class="panel">
					<div class="panel-heading">
						<div>
							<p class="eyebrow">Контроль результата</p>
							<h2>Кейсы утечек</h2>
						</div>
						<a class="text-link" href={ "/ui/cases?tenant_id=" + data.TenantID }>Перейти к кейсам</a>
					</div>
					@CasesCompactList(data.RecentCases)
				</section>
			</main>
			@BottomNav("reconciliation")
		</body>
	</html>
}

templ CasesPage(data CasesPageData) {
	<!DOCTYPE html>
	<html lang="ru">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ data.Title }</title>
			<link rel="stylesheet" href="/ui/static/ui.css"/>
			<script src="/ui/static/htmx.min.js" defer></script>
		</head>
		<body>
			@Header("cases")
			<main class="page">
				<section class="page-header">
					<div>
						<h1>Кейсы</h1>
						<p class="lede">Просматривайте кейсы утечек, принимайте решения и отслеживайте прогресс.</p>
					</div>
					<button class="button secondary export-button" type="button">Экспорт</button>
				</section>
				<section class="panel">
					@CaseFilters(data.Table)
				</section>
				<section class="metric-grid" aria-label="Сводка по кейсам">
					<article class="metric">
						<span>Открытые кейсы</span>
						<strong>{ data.OpenCasesLabel }</strong>
					</article>
					<article class="metric">
						<span>В работе</span>
						<strong>{ data.InvestigatingCasesLabel }</strong>
					</article>
					<article class="metric">
						<span>Закрытые</span>
						<strong>{ data.ClosedCasesLabel }</strong>
					</article>
					<article class="metric">
						<span>Сумма потенциальной утечки</span>
						<strong>{ data.PotentialLeakageLabel }</strong>
					</article>
				</section>
				<section class="cases-layout">
					<div class="panel">
						<div class="panel-heading">
							<div>
								<p class="eyebrow">Список</p>
								<h2>Найденные кейсы</h2>
							</div>
						</div>
						@CasesTable(data.Table)
					</div>
					@CasePreview(data.Preview)
				</section>
			</main>
			@BottomNav("cases")
		</body>
	</html>
}

templ CaseDetailPage(data CaseDetailPageData) {
	<!DOCTYPE html>
	<html lang="ru">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ data.Title }</title>
			<link rel="stylesheet" href="/ui/static/ui.css"/>
			<script src="/ui/static/htmx.min.js" defer></script>
		</head>
		<body>
			@Header("cases")
			<main class="page">
				@CaseDetailPanel(data.Panel)
			</main>
			@BottomNav("cases")
		</body>
	</html>
}

templ DocumentsPage(data DocumentsPageData) {
	<!DOCTYPE html>
	<html lang="ru">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ data.Title }</title>
			<link rel="stylesheet" href="/ui/static/ui.css"/>
			<script src="/ui/static/htmx.min.js" defer></script>
		</head>
		<body>
			@Header("documents")
			<main class="page">
				<section class="page-header">
					<div>
						<h1>Документы</h1>
						<p class="lede">Загружайте договоры, счета и usage exports. ИИ готовит draft JSON, оператор проверяет его перед отправкой в core-сервисы.</p>
					</div>
				</section>
				@ifError(data.Error)
				if data.UploadResult != "" {
					<div class="run-result success">{ data.UploadResult }</div>
				}
				<section class="documents-layout">
					<div class="panel form-panel">
						<div class="panel-heading">
							<div>
								<p class="eyebrow">Document intake</p>
								<h2>Новая загрузка</h2>
							</div>
						</div>
						@DocumentUploadForm(data.TenantID)
					</div>
					<div class="panel">
						<div class="panel-heading">
							<div>
								<p class="eyebrow">Очередь</p>
								<h2>Загруженные документы</h2>
							</div>
						</div>
						@DocumentsList(data)
					</div>
				</section>
			</main>
			@BottomNav("documents")
		</body>
	</html>
}
